{
  "name": "remotepad",
  "private": true,
  "version": "0.0.2-nightly.20261026",
  "description": "RemotePad \u2014 a lightweight control surface for remote development.",
  "scripts": {
    "dev": "pnpm --parallel --filter @remotepad/server --filter @remotepad/web dev",
    "dev:stable": "pnpm --parallel --filter @remotepad/server start --filter @remotepad/web dev",
    "build": "pnpm --filter @remotepad/shared build && pnpm --filter @remotepad/web build && pnpm --filter @remotepad/server build",
    "start": "pnpm --filter @remotepad/server start",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.15.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "node-pty"
    ]
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1"
  }
}
